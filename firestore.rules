rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Liderlik Tablosu & Oyuncu Profilleri
    match /leaderboard/{uid} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (!('username' in request.resource.data) || (request.resource.data.username is string && request.resource.data.username.size() <= 25))
        && (!('gold' in request.resource.data) || (request.resource.data.gold is number && request.resource.data.gold >= 0 && request.resource.data.gold <= 1000000))
        && (!('level' in request.resource.data) || (request.resource.data.level is number && request.resource.data.level >= 1 && request.resource.data.level <= 1000));
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && (!('username' in request.resource.data) || (request.resource.data.username is string && request.resource.data.username.size() <= 25))
        && (!('gold' in request.resource.data) || (request.resource.data.gold is number && request.resource.data.gold >= 0 && request.resource.data.gold <= 1000000))
        && (!('level' in request.resource.data) || (request.resource.data.level is number && request.resource.data.level >= 1 && request.resource.data.level <= 1000))
        && (!('gold' in request.resource.data) || !('gold' in resource.data) || request.resource.data.gold <= resource.data.gold + 1000);
      allow delete: if false;
    }

    // Oyun Tamamlama Kayıtları (Sadece Ekleme)
    match /game_records/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Canlı Düello Davetleri
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.targetUid == request.auth.uid);
      allow delete: if isSignedIn()
        && resource.data.fromUid == request.auth.uid;
    }

    // Aktif PvP Maçları
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (
          request.resource.data.player1.uid == request.auth.uid
          || (request.resource.data.player2 != null && request.resource.data.player2.uid == request.auth.uid)
        );
      allow update: if isSignedIn()
        && (
          resource.data.player1.uid == request.auth.uid
          || resource.data.status == 'waiting'
          || (resource.data.player2 != null && resource.data.player2.uid == request.auth.uid)
        );
      allow delete: if false;
    }

    // Diğer tüm koleksiyonlar kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
